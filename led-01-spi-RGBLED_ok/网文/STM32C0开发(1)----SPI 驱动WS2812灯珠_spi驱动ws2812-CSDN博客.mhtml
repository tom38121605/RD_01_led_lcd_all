=E6=8C=BD=E8=BE=93=E5=87=BA=E6=A8=A1=E5=BC=8F */
    GPIO_InitStructure.GPIO_Pin =3D GPIO_Pin_9;
    GPIO_InitStructure.GPIO_Speed =3D GPIO_Speed_50MHz;
    GPIO_InitStructure.GPIO_Mode =3D GPIO_Mode_AF_PP;
    GPIO_Init(GPIOA, &amp;GPIO_InitStructure);

    /* =E5=B0=86USART Rx=E7=9A=84GPIO=E9=85=8D=E7=BD=AE=E4=B8=BA=E6=B5=AE=
=E7=A9=BA=E8=BE=93=E5=85=A5=E6=A8=A1=E5=BC=8F */
    GPIO_InitStructure.GPIO_Pin =3D GPIO_Pin_10;
    GPIO_InitStructure.GPIO_Mode =3D GPIO_Mode_IN_FLOATING;
    GPIO_Init(GPIOA, &amp;GPIO_InitStructure);

