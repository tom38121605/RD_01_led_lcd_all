    USART_InitStructure.USART_WordLength =3D USART_WordLength_8b;
    USART_InitStructure.USART_StopBits =3D USART_StopBits_1;
    USART_InitStructure.USART_Parity =3D USART_Parity_No;
    USART_InitStructure.USART_HardwareFlowControl =3D USART_HardwareFlowCon=
trol_None;
    USART_InitStructure.USART_Mode =3D USART_Mode_Rx | USART_Mode_Tx;
    USART_Init(USART1, &amp;USART_InitStructure);

    USART_Cmd(USART1, ENABLE);
