void USART_Configuration(void)
{
    GPIO_InitTypeDef GPIO_InitStructure;
    USART_InitTypeDef USART_InitStructure;

    /* =E6=89=93=E5=BC=80=E4=B8=B2=E5=8F=A3=E5=AF=B9=E5=BA=94=E7=9A=84GPIO=
=E6=97=B6=E9=92=9F=E5=92=8CUSART=E6=97=B6=E9=92=9F */
