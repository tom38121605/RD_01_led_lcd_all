void USART_Send(USART_TypeDef* USARTx, uint8_t *pucBuffer, uint32_t ulCount=
)
{
    while(ulCount--)
    {
        USART_SendData(USARTx, (uint16_t)(*pucBuffer++));
        while(USART_GetFlagStatus(USARTx, USART_FLAG_TXE) =3D=3D RESET);
    }
}

void USART_Putc(USART_TypeDef* USARTx, uint8_t ch)
{
    USART_SendData(USARTx, (uint16_t)ch);
    while(USART_GetFlagStatus(USARTx, USART_FLAG_TXE) =3D=3D RESET);
}

int main()
{
    uint8_t cmd[20];
    int len;

    USART_Configuration();

    /* =E8=AE=BE=E7=BD=AEHC-05=E4=B8=BAAT=E6=A8=A1=E5=BC=8F */
    USART_Send(USART1, "AT+MODE1\r\n", 11);
    while(USART_GetFlagStatus(USART1, USART_FLAG_RXNE) =3D=3D RESET);
    USART_Putc(USART1, USART_ReceiveData(USART1));

    /* =E6=9F=A5=E8=AF=A2HC-05=E7=9A=84=E5=90=8D=E7=A7=B0 */
    USART_Send(USART1, "AT+NAME?\r\n", 10);
    while(USART_GetFlagStatus(USART1, USART_FLAG_RXNE) =3D=3D RESET);
    len =3D 0;
    while(USART_GetFlagStatus(USART1, USART_FLAG_RXNE) =3D=3D SET)
    {
        cmd[len++] =3D USART_ReceiveData(USART1);
    }
    cmd[len] =3D '\0';
    printf("The name of HC-05 is: %s\n", cmd);

    while(1);
}
